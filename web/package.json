{
  "name": "drivebridge-client",
  "version": "0.1.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "test": "python3 scripts/check.py -- pnpm exec vitest run",
    "test:e2e": "python3 scripts/check.py -- pnpm exec playwright test",
    "typecheck": "node scripts/check-ui.mjs && tsc --noEmit",
    "check:ui": "node scripts/check-ui.mjs",
    "prototype:dev": "vite --config prototypes/personal-agent-workspace/vite.config.ts",
    "prototype:build": "vite build --config prototypes/personal-agent-workspace/vite.config.ts && node prototypes/personal-agent-workspace/package-artifact.mjs",
    "prototype:test": "python3 scripts/check.py -- pnpm exec playwright test --config prototypes/personal-agent-workspace/playwright.config.ts",
    "prototype:unit": "python3 scripts/check.py -- pnpm exec vitest run --config prototypes/personal-agent-workspace/vitest.config.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.24.0",
      "onFail": "download"
    }
  },
  "type": "module",
